          400,
          100
        ],
        "parameters": {
          "sql": "SELECT time_bucket('1 day', time) AS bucket,\n       (array_agg(close ORDER BY time ASC))[1] AS close,\n       symbol\nFROM public.ohlc_data\nWHERE symbol = 'AAPL.US/USD'\n  AND time >= (now() - interval '30 days')\nGROUP BY bucket, symbol\nORDER BY bucket ASC"
        },
        "deprecated": null,
